<?xml version="1.0" encoding="utf-8"?>
<!--
    Source list for installing the tool built from this repository. It holds only the local
    package folder: nuget.org is never queried, so a package with the same identifier published
    by someone else cannot be installed instead of the local build. The install command is in the
    README.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="local" value="artifacts/packages" />
    </packageSources>
</configuration>
