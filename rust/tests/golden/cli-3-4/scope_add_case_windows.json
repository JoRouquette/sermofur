{
  "entries": [
    ".sermofur/",
    ".sermofur/instance.json",
    ".sermofur/memory.db",
    ".sermofur/records/",
    "Docs/",
    "Docs/Inner/"
  ],
  "projections": {},
  "steps": [
    {
      "output": {
        "exitCode": 0,
        "stderr": "",
        "stdout": "{\n  \"root\": \"<root>\",\n  \"configuration\": {\n    \"schemaVersion\": 2,\n    \"instanceId\": \"<g1>\",\n    \"createdAt\": \"<date>\"\n  },\n  \"created\": true\n}\n"
      },
      "step": {
        "arguments": [
          "init"
        ],
        "cwd": ""
      }
    },
    {
      "output": null,
      "step": {
        "mkdir": "Docs/Inner"
      }
    },
    {
      "output": {
        "exitCode": 0,
        "stderr": "",
        "stdout": "{\n  \"id\": \"d\",\n  \"kind\": \"client\",\n  \"parentId\": \"workspace\",\n  \"relativePath\": \"Docs\"\n}\n"
      },
      "step": {
        "arguments": [
          "scope",
          "add",
          "d",
          "client",
          "workspace",
          "docs"
        ],
        "cwd": ""
      }
    },
    {
      "output": {
        "exitCode": 0,
        "stderr": "",
        "stdout": "{\n  \"id\": \"i\",\n  \"kind\": \"project\",\n  \"parentId\": \"d\",\n  \"relativePath\": \"Docs/Inner\"\n}\n"
      },
      "step": {
        "arguments": [
          "scope",
          "add",
          "i",
          "project",
          "d",
          "DOCS/inner"
        ],
        "cwd": "Docs"
      }
    },
    {
      "output": {
        "exitCode": 1,
        "stderr": "smf: duplicate_mapping: Mapping already assigned.\n",
        "stdout": ""
      },
      "step": {
        "arguments": [
          "scope",
          "add",
          "d2",
          "client",
          "workspace",
          "DOCS"
        ],
        "cwd": ""
      }
    },
    {
      "output": {
        "exitCode": 0,
        "stderr": "",
        "stdout": "[\n  {\n    \"id\": \"workspace\",\n    \"kind\": \"workspace\",\n    \"parentId\": null,\n    \"relativePath\": null\n  }\n]\n"
      },
      "step": {
        "arguments": [
          "scope",
          "list"
        ],
        "cwd": ""
      }
    },
    {
      "output": {
        "exitCode": 0,
        "stderr": "",
        "stdout": "{\n  \"scope\": \"i\",\n  \"visible\": [\n    \"d\",\n    \"i\",\n    \"workspace\"\n  ]\n}\n"
      },
      "step": {
        "arguments": [
          "scope",
          "current"
        ],
        "cwd": "docs/inner"
      }
    }
  ]
}
